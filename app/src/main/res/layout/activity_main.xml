<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ======================================================== -->
    <!-- 1. FULL-SCREEN EDGE-TO-EDGE CAMERA VIEWFINDER            -->
    <!-- ======================================================== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Cyber HUD Center Scanning Reticle -->
    <View
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="@drawable/hud_reticle"/>

    <!-- ======================================================== -->
    <!-- 2. TOP COLLAPSIBLE HUD BAR                               -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutTopHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#DD070A12"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <!-- Top Bar Row 1: Brand, Status, and Action Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👻 LOGICGHOST"
                android:textColor="#00F0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginEnd="8dp"/>

            <!-- Compact URL Input Pill -->
            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="#202A3C"
                android:textColor="#00FF88"
                android:text="http://127.0.0.1:5000"
                android:hint="http://127.0.0.1:5000"
                android:textColorHint="#627D98"
                android:paddingHorizontal="8dp"
                android:textSize="10sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginEnd="6dp"/>

            <!-- 1-Click History Button -->
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="⏱️"
                android:textColor="#00F0FF"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="4dp"/>

            <!-- 1-Click USB Tethering Button -->
            <Button
                android:id="@+id/btnUsbTether"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="🔌"
                android:textColor="#00F0FF"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="4dp"/>

            <!-- 1-Click Setup Guide Button -->
            <Button
                android:id="@+id/btnGuide"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="❓"
                android:textColor="#00FF88"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="4dp"/>

            <!-- 1-Click Collapse / Hide HUD Button -->
            <Button
                android:id="@+id/btnToggleHud"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="👁️"
                android:textColor="#94A3B8"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"/>

        </LinearLayout>

        <!-- Top Bar Row 2: Status LEDs and Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="READY • ZERO-CONFIG USB"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <!-- Server Status Pill -->
            <LinearLayout
                android:id="@+id/cardServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#151E2E"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="6dp">
                <View
                    android:id="@+id/ledServer"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF3333"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVER: OFFLINE"
                    android:textColor="#E0E6ED"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Bluetooth Status Pill -->
            <LinearLayout
                android:id="@+id/cardBluetoothStatus"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#151E2E"
                android:paddingHorizontal="6dp">
                <View
                    android:id="@+id/ledBluetooth"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF3333"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/tvBluetoothStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BT: UNPAIRED"
                    android:textColor="#E0E6ED"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Floating Tiny HUD Restore Pill (Visible when Top HUD is hidden) -->
    <Button
        android:id="@+id/btnRestoreHud"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="👻 HUD"
        android:textColor="#00F0FF"
        android:background="@drawable/btn_pill_cyber"
        android:textSize="9sp"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:visibility="gone"/>

    <!-- ======================================================== -->
    <!-- 3. BOTTOM FLOATING DUAL CONTROL BARS                     -->
    <!-- ======================================================== -->

    <!-- LEFT SIDE: Typing & Quick Actions (Left Thumb) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Quick View Result Floating Pill -->
        <Button
            android:id="@+id/btnQuickResult"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📄 RESULT"
            android:textColor="#00F0FF"
            android:background="@drawable/btn_pill_cyber"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- USB Typing Button (Glowing Emerald/Cyan Pill) -->
        <Button
            android:id="@+id/btnTypeDirect"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="⚡ TYPE (USB)"
            android:background="@drawable/btn_direct_type"
            android:textColor="#051522"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:elevation="6dp"/>

        <!-- Bluetooth HID Typing Button (Cyber Glass Pill) -->
        <Button
            android:id="@+id/btnTypeBluetooth"
            android:layout_width="120dp"
            android:layout_height="38dp"
            android:text="📶 TYPE (BT)"
            android:background="@drawable/hud_panel_bg"
            android:textColor="#00FF88"
            android:textSize="10sp"
            android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- RIGHT SIDE: Aesthetic Glowing Camera Shutter Button (Right Thumb) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/btn_camera_shutter"
            android:contentDescription="Capture"
            android:elevation="10dp"/>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 4. EXPANDABLE / MAXIMIZEABLE RESULT SHEET                -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutResponseContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="76dp"
        android:layout_marginHorizontal="12dp"
        android:orientation="vertical"
        android:background="@drawable/hud_glass_card"
        android:padding="12dp"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Result Header Bar: Tag, Duration, Maximize, Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTagHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[TYPE]"
                android:textColor="#000000"
                android:textStyle="bold"
                android:background="#00FF88"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tvResultDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ 0.8s"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginStart="8dp"/>

            <!-- Copy Button -->
            <Button
                android:id="@+id/btnCopyResult"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="📋"
                android:textColor="#00F0FF"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="4dp"/>

            <!-- Maximize / Restore Toggle Button -->
            <Button
                android:id="@+id/btnMaximizeResult"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="⛶"
                android:textColor="#00F0FF"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="4dp"/>

            <!-- Close / Minimize Button -->
            <Button
                android:id="@+id/btnCloseResult"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="✕"
                android:textColor="#FF5555"
                android:background="#202A3C"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"/>
        </LinearLayout>

        <!-- Scrollable Result Body -->
        <ScrollView
            android:id="@+id/scrollResultBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. [VOICE] Mode: Large high-contrast typography for reading aloud -->
                <TextView
                    android:id="@+id/tvVoicePayload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <!-- 2. [CHECK] Mode -->
                <LinearLayout
                    android:id="@+id/layoutCheckMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCheckSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected: Option"
                        android:textColor="#00FF88"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 3. [COMPARE] Mode -->
                <LinearLayout
                    android:id="@+id/layoutCompareMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCompareBest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#00FF88"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvCompareReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- 4. [TYPE] Mode -->
                <LinearLayout
                    android:id="@+id/layoutTypeMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCodePayload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#38BDF8"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>