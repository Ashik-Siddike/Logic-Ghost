<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000F0FF">
    <item>
        <layer-list>
            <!-- 1. Outer Glowing Ambient Halo Ring -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2.5dp" android:color="#00F0FF" />
                    <solid android:color="#3000F0FF" />
                    <size android:width="76dp" android:height="76dp" />
                </shape>
            </item>
            <!-- 2. Middle Dark Glass Buffer -->
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="#90051522" />
                    <stroke android:width="1dp" android:color="#4000FF88" />
                </shape>
            </item>
            <!-- 3. Core Cute Pure Ivory Shutter Jewel -->
            <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#FFFFFF"
                        android:endColor="#E2E8F0"
                        android:angle="90" />
                    <stroke android:width="1.5dp" android:color="#00F0FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
